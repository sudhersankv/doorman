{
  "name": "doorman",
  "version": "0.1.0",
  "private": true,
  "description": "A self-improving harness at a website's door for visiting AI agents. MongoDB Atlas + Jev (System 1) + an editor that rewrites the harness config and proves each change on held-out goals.",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "test": "node --test \"test/unit/*.test.js\" \"test/e2e/*.test.js\"",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "node --test \"test/e2e/*.test.js\"",
    "setup-db": "node scripts/setup-db.js",
    "check": "node scripts/check-services.js",
    "goals": "node src/sim/goals.js",
    "bench": "node src/sim/run.js",
    "evolve": "node src/harness/evolve.js",
    "verify:demo": "node src/sim/verify-demo.js",
    "compare": "node src/baseline/compare.js"
  },
  "dependencies": {
    "mongodb": "^6.17.0",
    "playwright": "^1"
  }
}
